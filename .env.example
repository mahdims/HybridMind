# Multi-Model Configuration - At least ONE required
# Each agent uses a different AI provider for diverse perspectives
# Agents without API keys will be automatically disabled

# Agent 1: OpenAI GPT
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4
# OPENAI_TEMPERATURE=0.7

# Agent 2: Google Gemini (supports search via grounding)
GOOGLE_API_KEY=your_google_api_key_here
# GEMINI_MODEL=gemini-1.5-pro
# GEMINI_TEMPERATURE=0.7

# Agent 3: Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
# CLAUDE_TEMPERATURE=0.7

# Agent 4: Alibaba Qwen (with web search capability)
QWEN_API_KEY=your_qwen_api_key_here
# QWEN_MODEL=qwen-plus
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_TEMPERATURE=0.7
# QWEN_ENABLE_SEARCH=true

# Optional: GPT Researcher Configuration
# TAVILY_API_KEY=your_tavily_api_key_here

# GPT Researcher Settings (required to avoid errors)
EMBEDDING_PROVIDER=openai
# LLM_PROVIDER=openai
# FAST_LLM_MODEL=gpt-3.5-turbo
# SMART_LLM_MODEL=gpt-4

# Optional: Local Papers Directory
# PAPERS_DIR=./data/papers

# Optional: Output Directory
# OUTPUT_DIR=./output

# Optional: Logging
# LOG_LEVEL=INFO
